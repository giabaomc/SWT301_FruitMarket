    @Test // Excel CT-17
    public void ct17_eachBrowserSessionHasAnIndependentCart() {
        openCatalog();
        addProduct(7);
        openCart();
        assertLine(7, "Tao Fuji", 1, 75000.0);

        ChromeDriver secondSession = new ChromeDriver(new ChromeOptions());
        try {
            secondSession.manage().timeouts().implicitlyWait(Duration.ofSeconds(5));
            secondSession.get(baseUrl + "/cart?service=showCart");
            assertTrue("A separate browser session should start with an empty cart.",
                    secondSession.getPageSource().contains("Giỏ hàng của bạn đang trống."));
        } finally {
            secondSession.quit();
        }

        openCart();
        assertLine(7, "Tao Fuji", 1, 75000.0);
    }

