    private void openCatalog() {
        driver.get(baseUrl + "/productjsp?service=listProduct");
    }

    private void openCart() {
        driver.get(baseUrl + "/cart?service=showCart");
    }

    private void addProduct(int productId) {
        productRow(productId);
        clickAndWaitForNewPage(By.cssSelector(
                "a[href*='service=add2cart&productID=" + productId + "']"));
    }

    private WebElement productRow(int productId) {
        for (WebElement row : driver.findElements(By.cssSelector(".table-wrap table tbody tr"))) {
            List<WebElement> cells = row.findElements(By.tagName("td"));
            if (cells.size() >= 10 && String.valueOf(productId).equals(cells.get(0).getText().trim())) {
                return row;
            }
        }
        throw new AssertionError("Product ID " + productId + " is not visible in the product list.");
    }

    private WebElement productRowByName(String productName) {
        for (WebElement row : driver.findElements(By.cssSelector(".table-wrap table tbody tr"))) {
            if (row.getText().contains(productName)) {
                return row;
            }
        }
        return null;
    }

    private void login(String email, String password) {
        driver.get(baseUrl + "/productjsp?service=login");
        driver.findElement(By.id("txtemail")).sendKeys(email);
        driver.findElement(By.id("txtpass")).sendKeys(password);
        clickAndWaitForNewPage(By.cssSelector("input[type='submit']"));
        assertFalse("Login should succeed before the cart steps.",
                driver.getPageSource().contains("Login Failed!"));
    }

    private int cartLineCount() {
        int count = 0;
        for (WebElement row : driver.findElements(By.cssSelector(".table-wrap table tbody tr"))) {
            if (row.findElements(By.tagName("td")).size() == 6) count++;
        }
        return count;
    }

    private WebElement cartRow(int productId) {
        for (WebElement row : driver.findElements(By.cssSelector(".table-wrap table tbody tr"))) {
            List<WebElement> cells = row.findElements(By.tagName("td"));
            if (cells.size() == 6 && String.valueOf(productId).equals(cells.get(0).getText().trim())) {
                return row;
            }
        }
        throw new AssertionError("Cart line for product ID " + productId + " was not found.");
    }

    private int cartQuantity(int productId) {
        return Integer.parseInt(cartRow(productId).findElements(By.tagName("td")).get(3).getText().trim());
    }

    private void assertLine(int productId, String name, int quantity, double lineTotal) {
        List<WebElement> cells = cartRow(productId).findElements(By.tagName("td"));
        assertEquals(name, cells.get(1).getText().trim());
        assertEquals(quantity, Integer.parseInt(cells.get(3).getText().trim()));
        assertEquals(lineTotal, Double.parseDouble(cells.get(4).getText().trim()), 0.001);
    }

    private void assertTotal(String amount) {
        String total = driver.findElement(By.cssSelector(".cart-total")).getText();
        assertTrue("Unexpected total: " + total, total.contains(amount));
    }

    private void assertEmptyCart() {
        assertTrue(pageText().contains("Giỏ hàng của bạn đang trống."));
    }

    private String pageText() {
        return driver.findElement(By.tagName("body")).getText();
    }

    private void assertNoServerError() {
        String source = driver.getPageSource().toLowerCase();
        assertFalse("Unexpected HTTP 500 response.", source.contains("http status 500"));
        assertFalse("Unexpected server exception page.", source.contains("exception report"));
    }

    private static Connection openDatabase() throws Exception {
        String configPath = System.getProperty("configFile", "web/WEB-INF/ConnectDB.properties");
        Properties properties = new Properties();
        try (InputStream input = Files.newInputStream(Path.of(configPath))) {
            properties.load(input);
        }
        Class.forName("com.microsoft.sqlserver.jdbc.SQLServerDriver");
        return DriverManager.getConnection(
                properties.getProperty("url"),
                properties.getProperty("userID"),
                properties.getProperty("password"));
    }

    private static int productStatus(Connection connection, int productId) throws SQLException {
        try (PreparedStatement statement = connection.prepareStatement(
                "SELECT status FROM tblProducts WHERE productID=?")) {
            statement.setInt(1, productId);
            try (ResultSet result = statement.executeQuery()) {
                if (!result.next()) throw new SQLException("Seed product " + productId + " was not found.");
                return result.getInt(1);
            }
        }
    }

    private static void setProductStatus(Connection connection, int productId, int status) throws SQLException {
        try (PreparedStatement statement = connection.prepareStatement(
                "UPDATE tblProducts SET status=? WHERE productID=?")) {
            statement.setInt(1, status);
            statement.setInt(2, productId);
            if (statement.executeUpdate() != 1) {
                throw new SQLException("Could not update seed product " + productId + ".");
            }
        }
    }

    private static final class StockTestFixture implements AutoCloseable {
        private final int productId;
        private final boolean created;
        private final int oldQuantity;
        private final int oldStatus;

        private StockTestFixture(int productId, boolean created, int oldQuantity, int oldStatus) {
            this.productId = productId;
            this.created = created;
            this.oldQuantity = oldQuantity;
            this.oldStatus = oldStatus;
        }

        static StockTestFixture prepare() throws Exception {
            try (Connection connection = openDatabase()) {
                try (PreparedStatement find = connection.prepareStatement(
                        "SELECT TOP 1 productID, quantity, status FROM tblProducts WHERE productName=? ORDER BY productID")) {
                    find.setString(1, STOCK_TEST_NAME);
                    try (ResultSet result = find.executeQuery()) {
                        if (result.next()) {
                            int id = result.getInt("productID");
                            int quantity = result.getInt("quantity");
                            int status = result.getInt("status");
                            try (PreparedStatement update = connection.prepareStatement(
                                    "UPDATE tblProducts SET quantity=2, status=1 WHERE productID=?")) {
                                update.setInt(1, id);
                                update.executeUpdate();
                            }
                            return new StockTestFixture(id, false, quantity, status);
                        }
                    }
                }

                LocalDate today = LocalDate.now();
                String insertSql = "INSERT INTO tblProducts "
                        + "(productName, image, price, quantity, categoryID, importDate, expiryDate, status) "
                        + "VALUES (?, NULL, 10000, 2, 'TAO', ?, ?, 1)";
                try (PreparedStatement insert = connection.prepareStatement(insertSql, Statement.RETURN_GENERATED_KEYS)) {
                    insert.setString(1, STOCK_TEST_NAME);
                    insert.setDate(2, Date.valueOf(today));
                    insert.setDate(3, Date.valueOf(today.plusDays(30)));
                    insert.executeUpdate();
                    try (ResultSet keys = insert.getGeneratedKeys()) {
                        if (!keys.next()) throw new SQLException("Could not get Stock Test product ID.");
                        return new StockTestFixture(keys.getInt(1), true, 0, 1);
                    }
                }
            }
        }

        @Override
        public void close() throws Exception {
            try (Connection connection = openDatabase()) {
                String sql = created
                        ? "DELETE FROM tblProducts WHERE productID=?"
                        : "UPDATE tblProducts SET quantity=?, status=? WHERE productID=?";
                try (PreparedStatement statement = connection.prepareStatement(sql)) {
                    if (created) {
                        statement.setInt(1, productId);
                    } else {
                        statement.setInt(1, oldQuantity);
                        statement.setInt(2, oldStatus);
                        statement.setInt(3, productId);
                    }
                    statement.executeUpdate();
                }
            }
        }
    }
