    @Test // Excel CT-06; the test sets and restores the product status itself.
    public void ct06_deactivatedProductCannotBeAdded() {
        try (Connection connection = openDatabase()) {
            int originalStatus = productStatus(connection, 2);
            try {
                setProductStatus(connection, 2, 0);
                openCatalog();
                WebElement row = productRow(2);
                assertTrue("Product 2 should be DeActive for CT-06.",
                        row.findElements(By.tagName("td")).get(8).getText().contains("DeActive"));
                addProduct(2);
                openCart();
                assertFalse("A DeActive product must not appear in the cart.",
                        pageText().contains("Dua hau khong hat"));
            } finally {
                setProductStatus(connection, 2, originalStatus);
            }
        } catch (Exception ex) {
            throw new AssertionError("Could not prepare/restore product 2 for CT-06.", ex);
        }
    }

    @Test // Excel CT-07; the test creates or temporarily adjusts Stock Test.
    public void ct07_cartQuantityCannotExceedStock() throws Exception {
        try (StockTestFixture fixture = StockTestFixture.prepare()) {
        openCatalog();
        WebElement row = productRowByName(STOCK_TEST_NAME);
        assertNotNull("The Stock Test fixture should be visible in the catalog.", row);
        assertEquals("2", row.findElements(By.tagName("td")).get(4).getText().trim());
        int productId = Integer.parseInt(row.findElements(By.tagName("td")).get(0).getText().trim());
        addProduct(productId);
        addProduct(productId);
        addProduct(productId);
        openCart();
        assertTrue("Cart quantity must not exceed stock (2).", cartQuantity(productId) <= 2);
        }
    }

