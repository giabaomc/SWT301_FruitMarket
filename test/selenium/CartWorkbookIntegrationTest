    /** The base catalog and login accounts come from the project's seed script. */
    @Before
    public void requireSeedData() {
        String missingData = null;
        try (Connection connection = openDatabase()) {
            String productsSql = "SELECT COUNT(*) FROM tblProducts WHERE "
                    + "(productID=2 AND productName=N'Dua hau khong hat') OR "
                    + "(productID=6 AND productName=N'Chuoi tieu') OR "
                    + "(productID=7 AND productName=N'Tao Fuji') OR "
                    + "(productID=10 AND productName=N'Thom mat')";
            try (Statement statement = connection.createStatement();
                 ResultSet result = statement.executeQuery(productsSql)) {
                result.next();
                if (result.getInt(1) != 4) {
                    missingData = "Run sql/fruit_market.sql first; expected seed products are missing.";
                }
            }

            String usersSql = "SELECT COUNT(DISTINCT email) FROM tblUsers "
                    + "WHERE email IN (?, ?)";
            try (PreparedStatement statement = connection.prepareStatement(usersSql)) {
                statement.setString(1, ADMIN_EMAIL);
                statement.setString(2, CUSTOMER_EMAIL);
                try (ResultSet result = statement.executeQuery()) {
                    result.next();
                    if (result.getInt(1) != 2 && missingData == null) {
                        missingData = "Run sql/fruit_market.sql first; seeded admin/customer accounts are missing.";
                    }
                }
            }
        } catch (Exception ex) {
            missingData = "SQL Server or the configured test database is unavailable: "
                    + ex.getClass().getSimpleName();
        }
        Assume.assumeTrue(missingData == null, missingData);
    }

